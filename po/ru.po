"The admins of this group have restricted you from writing here until {date}"
msgstr "Администраторы группы запретили Вам писать в ней до {date}"

#: src/expressions.rs:124
msgid "Writing messages isn't allowed in this group."
msgstr "В этой группе запрещено отправлять сообщения."

#: src/main.rs:166
msgid "Prints application version"
msgstr "Вывести версию приложения"

#: src/main.rs:175
msgid "Specify the minimum log level"
msgstr "Указать минимальный уровень журнала"

#: src/main.rs:184
msgid "Override the builtin client id"
msgstr "Переопределить встроенный client id"

#: src/main.rs:193
msgid "Override the builtin client secret"
msgstr "Переопределить встроенный client secret"

#: src/main.rs:202
msgid "Whether to use a test data center on first account"
msgstr ""
"Использовать ли тестовый центр обработки данных на первой учетной записи"

#: src/model/chat_list.rs:322
msgid "Only folders can be deleted."
msgstr "Удалять можно только папки."

#: src/model/country_info.rs:99
msgid "Invalid Country Code"
msgstr "Недействительный код страны"

#: src/model/country_info.rs:108
msgid "Test Account"
msgstr "Тестовая учетная запись"

#: src/strings/chat_action.rs:29
msgid "{sender} is choosing a contact"
msgstr "{sender} выбирает контакт"

#: src/strings/chat_action.rs:31
msgid "{sender1} and {sender2} are choosing contacts"
msgstr "{sender1} и {sender2} выбирают контакты"

#: src/strings/chat_action.rs:35
msgid "{num} people are choosing contacts"
msgstr "{num} человек(а) выбирают контакты"

