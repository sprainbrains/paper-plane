using Gtk 4.0;
using Adw 1;

template $Session : Adw.Bin {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 260;
      max-sidebar-width: 340;
      sidebar-width-fraction: 0.4;

      sidebar: Adw.NavigationPage {
        title: _("Chats");

        child: $PaplSidebar sidebar {
          compact: bind split_view.collapsed;
          selected-chat: bind-property content.chat bidirectional;
          session: bind template.model;
        };
      };

      content: Adw.NavigationPage {
        tag: "content";
        title: _("Content");
        child: Box {
          $Content content {
            hexpand: true;
          }

          Separator picker_separator {
            visible: bind content_picker_revealer.reveal-child;
          }

          Revealer content_picker_revealer {
            transition-type: slide_left;
            visible: bind content_picker_revealer.reveal-child;

            $PaplContentPicker content_picker {
              width-request: 360;
              session: bind template.model;
              chat: bind content.chat;
            }
          }
        };
      };
    };

    Adw.Breakpoint {
      condition ("max-width: 560sp")
      setters {
        split_view.collapsed: true;
      }
    }
  };
}
