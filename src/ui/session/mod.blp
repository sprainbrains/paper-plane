using Gtk 4.0;
using Adw 1;

template $Session : Adw.Bin {
  child: Adw.BreakpointBin {
    width-request: 360;
    height-request: 200;

    child: Adw.NavigationSplitView split_view {
      min-sidebar-width: 260;
      max-sidebar-width: 340;
      sidebar-width-fraction: 0.4;

      sidebar: Adw.NavigationPage {
        title: _("Chats");

        child: Box {
          orientation: horizontal;

          $PaplSidebar sidebar {
            hexpand: true;
            compact: bind split_view.collapsed;
            selected-chat: bind content.chat bidirectional;
            session: bind template.model;
          }

          Separator sidebar_resize_handle {
            styles ["panel-resize-handle"]
          }
        };
      };

      content: Adw.NavigationPage {
        tag: "content";
        title: _("Content");
        child: Adw.OverlaySplitView content_picker_split {
          sidebar-position: end;
          show-sidebar: false;
          min-sidebar-width: 260;
          max-sidebar-width: 420;
          sidebar-width-fraction: 0.35;

          content: $Content content {
            hexpand: true;
            compact: bind split_view.collapsed;
          };

          sidebar: Box {
            orientation: horizontal;

            Separator picker_resize_handle {
              styles ["panel-resize-handle"]
            }

            $PaplContentPicker content_picker {
              hexpand: true;
              width-request: 260;
              show-window-controls: true;
              session: bind template.model;
              chat: bind content.chat;
            }
          };
        };
      };
    };

    // BreakpointBin applies only the *last* matching breakpoint, so these must be
    // ordered widest-first and each narrower one must repeat the wider setters.
    Adw.Breakpoint {
      condition ("max-width: 860sp")
      setters {
        content_picker_split.collapsed: true;
      }
    }

    Adw.Breakpoint {
      condition ("max-width: 560sp")
      setters {
        content_picker_split.collapsed: true;
        split_view.collapsed: true;
      }
    }
  };
}
