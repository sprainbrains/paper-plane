using Gtk 4.0;

menu menu {
  section {
    item {
      label: _("Edit Folder");
      action: "chat-folder-row.edit";
    }

    item {
      label: _("Mark All as Read");
      action: "chat-folder-row.mark-read";
    }
  }

  section {
    item {
      label: _("_Remove");
      action: "chat-folder-row.remove";
    }
  }
}

PopoverMenu popover_menu {
  menu-model: menu;
  has-arrow: false;
}