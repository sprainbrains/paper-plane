using Gtk 4.0;
using Adw 1;

template $PaplSidebarChatFolderEditWindow: Adw.Window {
  title: _("Edit Folder");
  modal: true;
  // 400 fit the English header ("Cancel | Include Exclude | Save"); the
  // Russian tab titles ("Включить"/"Исключить") ellipsized at that
  // width; 520 gives the header switcher its natural size.
  default-width: 520;
  default-height: 680;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      show-start-title-buttons: false;
      show-end-title-buttons: false;

      [start]
      Button {
        label: _("Cancel");

        clicked => $on_cancel() swapped;
      }

      title-widget: Adw.ViewSwitcher {
        stack: view_stack;
        policy: wide;
      };

      [end]
      Button save_button {
        label: _("Save");

        styles ["suggested-action"]

        clicked => $on_save() swapped;
      }
    }

    content: Box {
      orientation: vertical;
      spacing: 6;

      Box {
        spacing: 6;
        margin-start: 12;
        margin-end: 12;
        margin-top: 12;

        MenuButton icon_button {
          valign: center;
          tooltip-text: _("Folder Icon");

          styles ["flat"]
        }

        Entry name_entry {
          hexpand: true;
          placeholder-text: _("Folder Name");
        }
      }

      Adw.ViewStack view_stack {
        vexpand: true;

        Adw.ViewStackPage {
          name: "include";
          title: _("Include");
          icon-name: "list-add-symbolic";

          child: Box {
            orientation: vertical;
            spacing: 12;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;

            Adw.PreferencesGroup {
              title: _("Chat Types");

              Adw.SwitchRow include_contacts_row {
                title: _("Contacts");
              }

              Adw.SwitchRow include_non_contacts_row {
                title: _("Non-Contacts");
              }

              Adw.SwitchRow include_groups_row {
                title: _("Groups");
              }

              Adw.SwitchRow include_channels_row {
                title: _("Channels");
              }

              Adw.SwitchRow include_bots_row {
                title: _("Bots");
              }
            }

            SearchEntry search_entry {
              placeholder-text: _("Search Chats");

              search-changed => $on_search_changed() swapped;
            }

            ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              ListView list_view {
                model: NoSelection {
                  model: FilterListModel filter_model {
                    filter: CustomFilter custom_filter {};
                  };
                };

                styles ["navigation-sidebar"]
              }
            }
          };
        }

        Adw.ViewStackPage {
          name: "exclude";
          title: _("Exclude");
          icon-name: "list-remove-symbolic";

          child: Box {
            orientation: vertical;
            spacing: 12;
            margin-start: 12;
            margin-end: 12;
            margin-top: 12;
            margin-bottom: 12;

            Adw.PreferencesGroup {
              title: _("Chat Types");

              Adw.SwitchRow exclude_muted_row {
                title: _("Muted");
              }

              Adw.SwitchRow exclude_read_row {
                title: _("Read");
              }

              Adw.SwitchRow exclude_archived_row {
                title: _("Archived");
              }
            }

            SearchEntry exclude_search_entry {
              placeholder-text: _("Search Chats");

              search-changed => $on_exclude_search_changed() swapped;
            }

            ScrolledWindow {
              vexpand: true;
              hscrollbar-policy: never;

              ListView exclude_list_view {
                model: NoSelection {
                  model: FilterListModel exclude_filter_model {
                    filter: CustomFilter exclude_custom_filter {};
                  };
                };

                styles ["navigation-sidebar"]
              }
            }
          };
        }
      }
    };
  };
}
