using Gtk 4.0;
using Adw 1;

template $PaplForwardWindow: Adw.Window {
  title: _("Forward To…");
  modal: true;
  default-width: 360;
  default-height: 600;

  content: Adw.ToolbarView {
    [top]
    Adw.HeaderBar {
      title-widget: SearchEntry search_entry {
        placeholder-text: _("Search");

        search-changed => $search_changed() swapped;
      };

      [start]
      Button topics_back_button {
        visible: false;
        icon-name: "go-previous-symbolic";

        clicked => $back_to_chats() swapped;

        styles ["flat"]
      }
    }

    content: Stack forward_stack {
      vexpand: true;

      StackPage {
        name: "chats";

        child: ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          Adw.ClampScrollable {
            child: ListView list_view {
              single-click-activate: true;

              activate => $list_activate() swapped;

              model: NoSelection {
                model: FilterListModel filter_model {
                  filter: CustomFilter custom_filter {};
                };
              };

              factory: BuilderListItemFactory {
                template ListItem {
                  child: Box {
                    spacing: 6;

                    $PaplAvatar {
                      size: 32;
                      item: bind template.item as <$ChatListItem>.chat;
                    }

                    Inscription {
                      hexpand: true;
                      text-overflow: ellipsize_end;
                      text: bind template.item as <$ChatListItem>.chat as <$Chat>.title;
                    }
                  };
                }
              };

              styles [
                "navigation-sidebar",
              ]
            };
          }
        };
      }

      StackPage {
        name: "topics";

        child: ScrolledWindow {
          vexpand: true;
          hscrollbar-policy: never;

          ListView topic_list_view {
            single-click-activate: true;

            activate => $topic_activate() swapped;

            styles [
              "navigation-sidebar",
            ]
          }
        };
      }
    };
  };
}
