using Gtk 4.0;

template $PaplMessageAlbum : $PaplMessageBase {
  layout-manager: BinLayout {};

  $PaplMessageBubble message_bubble {
    styles ["media"]

    // Holds either a photo/video grid or a stack of document rows,
    // depending on what the album members are.
    prefix: Box album_content {
      orientation: vertical;
    };
  }
}
