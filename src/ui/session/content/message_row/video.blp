using Gtk 4.0;
using Adw 1;

template $PaplMessageVideo : $PaplMessageBase {
  layout-manager: BinLayout {};

  $PaplMessageBubble message_bubble {
    styles ["media"]

    prefix: Overlay {
      $PaplMessageMediaPicture picture {}

      [overlay]
      Label indicator {
        halign: start;
        valign: start;

        styles ["osd-indicator"]
      }

      [overlay]
      Image play_button {
        visible: false;
        halign: center;
        valign: center;
        icon-name: "media-playback-start-symbolic";
        pixel-size: 48;

        styles ["osd"]
      }
    };
  }
}
