using Gtk 4.0;

template $PaplMessageIndicators {
  layout-manager: BoxLayout {
    spacing: 3;
  };

  Box view_count_box {
    spacing: 3;

    Image {
      icon-name: "view-reveal-symbolic";
    }

    Label view_count_label {}
  }

  Box reply_count_box {
    spacing: 3;

    Image {
      icon-name: "mail-reply-sender-symbolic";
    }

    Label reply_count_label {}
  }

  Image pinned_icon {
    icon-name: "view-pin-symbolic";
    pixel-size: 12;
    visible: false;
  }

  Label message_info_label {}
  Image sending_state_icon {}
}
