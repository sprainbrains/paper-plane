using Gtk 4.0;
using Adw 1;

template $PaplEventRow : Adw.Bin {
  styles ["event-row"]

  halign: center;

  child: Box {
    orientation: vertical;
    spacing: 6;
    halign: center;

    Picture thumbnail {
      visible: false;
      width-request: 80;
      height-request: 80;
      content-fit: cover;

      styles ["event-photo"]
    }

    Label label {
      justify: center;
      wrap: true;
      wrap-mode: word_char;
    }
  };
}
