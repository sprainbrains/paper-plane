using Gtk 4.0;
using Adw 1;

template $PaplContentPicker : Widget {
  styles ["content-picker"]
  layout-manager: BoxLayout {
    orientation: vertical;
  };

  Adw.HeaderBar header_bar {
    show-start-title-buttons: false;
    show-end-title-buttons: bind template.show-window-controls;
    styles ["content-picker-header"]

    title-widget: Adw.ToggleGroup tabs {
      valign: center;
      homogeneous: true;

      Adw.Toggle {
        name: "emoji";
        label: _("Emoji");
      }

      Adw.Toggle {
        name: "stickers";
        label: _("Stickers");
      }

      Adw.Toggle {
        name: "gifs";
        label: _("GIFs");
      }
    };
  }

  SearchEntry search_entry {
    placeholder-text: _("Search");
    margin-start: 12;
    margin-end: 12;
    margin-top: 6;
    margin-bottom: 6;
  }

  Stack content_stack {
    vexpand: true;
    transition-type: crossfade;

    ScrolledWindow emoji_page {
      hscrollbar-policy: never;

      ListView emoji_list {
        single-click-activate: false;
        styles ["emoji-picker-list"]
      }
    }

    ScrolledWindow sticker_page {
      hscrollbar-policy: never;

      ListView sticker_list {
        single-click-activate: false;
        styles ["sticker-picker-list"]
      }
    }

    ScrolledWindow gif_page {
      hscrollbar-policy: never;

      GridView gif_grid {
        single-click-activate: true;
        min-columns: 2;
        max-columns: 3;
        margin-start: 12;
        margin-end: 12;
        margin-top: 6;
        margin-bottom: 12;
        styles ["gif-picker-grid"]
      }
    }
  }

  Separator {}

  ScrolledWindow navigation_rail_scroll {
    height-request: 44;
    vscrollbar-policy: never;
    hscrollbar-policy: automatic;

    Box navigation_rail {
      spacing: 2;
      margin-start: 6;
      margin-end: 6;
      valign: center;
    }
  }
}
