<?xml version="1.0" encoding="UTF-8"?>
<interface>

  <template class="PaplChatHistory" parent="AdwBin">
    <child>
      <object class="GtkOverlay" id="send_overlay">
        <child>
          <object class="AdwToastOverlay" id="toast_overlay">
            <property name="child">
          <object class="AdwToolbarView">
        <child type="top">
          <object class="GtkOverlay">
            <child>
              <object class="AdwHeaderBar">
                <child type="start">
                  <object class="GtkButton" id="back_button">
                    <property name="visible">False</property>
                    <property name="valign">center</property>
                    <property name="action-name">chat-history.go-back</property>
                    <property name="tooltip-text" translatable="yes">Back</property>
                    <child>
                      <object class="GtkImage">
                        <property name="icon-name">go-previous-symbolic</property>
                      </object>
                    </child>
                    <style>
                      <class name="flat"/>
                    </style>
                  </object>
                </child>
                <child type="start">
                  <object class="PaplAvatar" id="header_avatar">
                    <property name="size">28</property>
                    <property name="valign">center</property>
                  </object>
                </child>
                <child type="title">
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="PaplChatTitle" id="header_chat_title">
                        <property name="halign">center</property>
                      </object>
                    </child>
                    <child>
                      <object class="GtkBox" id="header_typing_box">
                        <property name="visible">False</property>
                        <property name="halign">center</property>
                        <property name="spacing">4</property>
                        <child>
                          <object class="GtkBox">
                            <property name="valign">center</property>
                            <style>
                              <class name="typing-dots"/>
                            </style>
                            <child>
                              <object class="GtkBox">
                                <style><class name="typing-dot"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style><class name="typing-dot"/></style>
                              </object>
                            </child>
                            <child>
                              <object class="GtkBox">
                                <style><class name="typing-dot"/></style>
                              </object>
                            </child>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="header_typing_label">
                            <property name="ellipsize">end</property>
                            <style>
                              <class name="accent"/>
                              <class name="caption"/>
                            </style>
                          </object>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
                <child type="end">
                  <object class="GtkMenuButton">
                    <property name="icon-name">view-more-symbolic</property>
                    <property name="menu-model">chat-menu-model</property>
                  </object>
                </child>
              </object>
            </child>
            <child type="overlay">
              <object class="PaplSnow" id="PaplSnow">
                <property name="sensitive">False</property>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="GtkBox" id="pinned_message_bar">
            <property name="visible">False</property>
            <property name="spacing">8</property>
            <style>
              <class name="toolbar"/>
              <class name="pinned-message"/>
            </style>
            <child>
              <object class="GtkBox" id="pinned_content">
                <property name="spacing">8</property>
                <property name="hexpand">True</property>
                <style>
                  <class name="pinned-content"/>
                </style>
                <child>
                  <object class="GtkBox" id="pinned_dots">
                    <property name="orientation">vertical</property>
                    <property name="valign">center</property>
                    <property name="spacing">2</property>
                  </object>
                </child>
                <child>
                  <object class="GtkPicture" id="pinned_thumbnail">
                    <property name="visible">False</property>
                    <property name="content-fit">cover</property>
                    <property name="overflow">hidden</property>
                    <property name="width-request">34</property>
                    <property name="height-request">34</property>
                    <property name="valign">center</property>
                    <style>
                      <class name="pinned-thumbnail"/>
                    </style>
                  </object>
                </child>
                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="hexpand">True</property>
                    <property name="valign">center</property>
                    <child>
                      <object class="GtkLabel" id="pinned_title_label">
                        <property name="label" translatable="yes">Pinned Message</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="caption-heading"/>
                          <class name="accent"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pinned_message_label">
                        <property name="xalign">0</property>
                        <property name="ellipsize">end</property>
                        <property name="single-line-mode">True</property>
                        <style>
                          <class name="dim-label"/>
                          <class name="caption"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="icon-name">view-list-symbolic</property>
                <property name="action-name">chat-history.pinned-list</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">All Pinned Messages</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton" id="unpin_button">
                <property name="icon-name">pin-crossed-symbolic</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Unpin for Everyone</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="icon-name">view-conceal-symbolic</property>
                <property name="action-name">chat-history.hide-pinned</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Hide Pinned Panel</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <child type="top">
          <object class="GtkBox" id="selection_bar">
            <property name="visible">False</property>
            <property name="spacing">6</property>
            <style>
              <class name="toolbar"/>
            </style>
            <child>
              <object class="GtkButton">
                <property name="action-name">chat-history.selection-forward</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Forward</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">mail-forward-symbolic</property>
                    <property name="label" translatable="yes">Forward</property>
                    <property name="can-shrink">True</property>
                  </object>
                </property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="action-name">chat-history.selection-copy</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Copy Text</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">edit-copy-symbolic</property>
                    <property name="label" translatable="yes">Copy Text</property>
                    <property name="can-shrink">True</property>
                  </object>
                </property>
                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="action-name">chat-history.selection-delete</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Delete</property>
                <property name="child">
                  <object class="AdwButtonContent">
                    <property name="icon-name">user-trash-symbolic</property>
                    <property name="label" translatable="yes">Delete</property>
                    <property name="can-shrink">True</property>
                  </object>
                </property>
                <style>
                  <class name="flat"/>
                  <class name="destructive-action"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkLabel" id="selection_count_label">
                <property name="hexpand">True</property>
                <property name="xalign">0.5</property>
                <property name="ellipsize">end</property>
                <style>
                  <class name="heading"/>
                </style>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="icon-name">window-close-symbolic</property>
                <property name="action-name">chat-history.selection-clear</property>
                <property name="valign">center</property>
                <property name="tooltip-text" translatable="yes">Clear Selection</property>
                <style>
                  <class name="flat"/>
                  <class name="circular"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="GtkOverlay" id="content_overlay">
            <child type="overlay">
              <object class="GtkBox" id="pinned_view">
                <property name="visible">False</property>
                <property name="orientation">vertical</property>
                <style>
                  <class name="background"/>
                </style>
                <child>
                  <object class="GtkBox">
                    <property name="spacing">6</property>
                    <style>
                      <class name="toolbar"/>
                    </style>
                    <child>
                      <object class="GtkButton">
                        <property name="icon-name">go-previous-symbolic</property>
                        <property name="action-name">chat-history.pinned-list-close</property>
                        <property name="valign">center</property>
                        <property name="tooltip-text" translatable="yes">Back</property>
                        <style>
                          <class name="flat"/>
                          <class name="circular"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="pinned_view_title">
                        <property name="hexpand">True</property>
                        <property name="xalign">0</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
                <child>
                  <object class="GtkScrolledWindow">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClamp">
                        <property name="maximum-size">800</property>
                        <property name="tightening-threshold">600</property>
                        <property name="child">
                          <object class="GtkListBox" id="pinned_list_box">
                            <property name="selection-mode">none</property>
                            <property name="valign">start</property>
                            <style>
                              <class name="background"/>
                            </style>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                </child>
              </object>
            </child>
            <child type="overlay">
              <object class="GtkRevealer">
                <property name="transition-type">slide-up</property>
                <property name="reveal-child" bind-source="PaplChatHistory"
                  bind-property="sticky" bind-flags="sync-create|invert-boolean"/>
                <property name="valign">end</property>
                <property name="halign">end</property>
                <child>
                  <object class="GtkOverlay">
                    <child type="overlay">
                      <object class="GtkLabel">
                        <property name="halign">center</property>
                        <property name="valign">start</property>
                        <property name="ellipsize">middle</property>
                        <binding name="label">
                          <lookup name="unread-count" type="Chat">
                            <lookup name="chat">PaplChatHistory</lookup>
                          </lookup>
                        </binding>
                        <binding name="visible">
                          <lookup name="unread-count" type="Chat">
                            <lookup name="chat">PaplChatHistory</lookup>
                          </lookup>
                        </binding>
                        <style>
                          <class name="unread-count"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkButton">
                        <property name="halign">center</property>
                        <property name="valign">end</property>
                        <property name="icon-name">go-down-symbolic</property>
                        <property name="action-name">chat-history.scroll-down</property>
                        <accessibility>
                          <property name="label" translatable="yes">Scroll to bottom</property>
                        </accessibility>
                        <style>
                          <class name="circular"/>
                          <class name="opaque"/>
                          <class name="scroll-to-bottom"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>
            <child>
              <object class="PaplContentBackground" id="background">
                <property name="vexpand">True</property>
                <property name="child">
                  <object class="GtkBox" id="thread_body">
                    <property name="orientation">vertical</property>
                    <child>
                      <object class="GtkRevealer" id="thread_header">
                        <property name="visible">False</property>
                        <property name="transition-type">none</property>
                        <child>
                          <object class="AdwClamp">
                            <property name="maximum-size">800</property>
                            <property name="tightening-threshold">600</property>
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>
                                <property name="margin-top">6</property>
                                <property name="margin-bottom">6</property>
                                <child>
                                  <object class="PaplChatHistoryRow" id="thread_anchor_row"/>
                                </child>
                                <child>
                                  <object class="GtkLabel" id="thread_divider_label">
                                    <property name="halign">center</property>
                                    <property name="margin-top">8</property>
                                    <property name="margin-bottom">4</property>
                                    <property name="label" translatable="yes">Start of discussion</property>
                                    <style>
                                      <class name="pill"/>
                                      <class name="dim-label"/>
                                      <class name="caption"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>
                      </object>
                    </child>
                    <child>
                  <object class="GtkScrolledWindow" id="scrolled_window">
                    <property name="vexpand">True</property>
                    <property name="hscrollbar-policy">never</property>
                    <property name="child">
                      <object class="AdwClampScrollable">
                        <property name="maximum-size">800</property>
                        <property name="tightening-threshold">600</property>
                        <property name="vscroll-policy">natural</property>
                        <property name="child">
                          <object class="GtkListView" id="list_view">
                            <style>
                              <class name="chat-history"/>
                            </style>
                            <property name="factory">
                              <object class="GtkBuilderListItemFactory">
                                <property name="bytes"><![CDATA[
<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="GtkListItem">
    <property name="activatable">False</property>
    <property name="child">
      <object class="PaplChatHistoryRow">
        <binding name="item">
          <lookup name="item">GtkListItem</lookup>
        </binding>
      </object>
    </property>
  </template>
</interface>
                        ]]></property>
                              </object>
                            </property>
                          </object>
                        </property>
                      </object>
                    </property>
                  </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="bottom">
          <object class="AdwClamp">
            <property name="maximum-size">800</property>
            <property name="tightening-threshold">600</property>
            <property name="child">
              <object class="PaplChatActionBar" id="chat_action_bar">
                <binding name="chat">
                  <lookup name="chat">PaplChatHistory</lookup>
                </binding>
              </object>
            </property>
          </object>
        </child>
          </object>
            </property>
          </object>
        </child>
      </object>
    </child>
  </template>
  <menu id="chat-menu-model">
    <section>
      <item>
        <attribute name="label" translatable="yes">View Info</attribute>
        <attribute name="action">chat-history.view-info</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Show Pinned Panel</attribute>
        <attribute name="action">chat-history.show-pinned</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Leave Chat</attribute>
        <attribute name="action">chat-history.leave-chat</attribute>
        <attribute name="hidden-when">action-disabled</attribute>
      </item>
    </section>
  </menu>
</interface>
