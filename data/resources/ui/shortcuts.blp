using Gtk 4.0;
using Adw 1;

Adw.ShortcutsDialog shortcuts_dialog {
  Adw.ShortcutsSection {
    title: C_("shortcut window", "General");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Show Shortcuts");
      action-name: "win.show-shortcuts";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Quit");
      action-name: "app.quit";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Window");
      accelerator: "<ctrl>w";
    }

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Close Dialog");
      accelerator: "Escape";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Chat List");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Search Chats");
      accelerator: "<ctrl><shift>f";
    }
  }

  Adw.ShortcutsSection {
    title: C_("shortcut window", "Chat History");

    Adw.ShortcutsItem {
      title: C_("shortcut window", "Send Photo from Clipboard");
      accelerator: "<ctrl>v";
    }
  }
}
