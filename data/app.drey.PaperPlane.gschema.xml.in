<?xml version="1.0" encoding="utf-8"?>
<schemalist>
  <schema path="/app/drey/paper-plane/" id="@app-id@" gettext-domain="@gettext-package@">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Default window width</summary>
      <description>Default window width</description>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Default window height</summary>
      <description>Default window height</description>
    </key>
    <key name="is-maximized" type="b">
      <default>false</default>
      <summary>Default window maximized behaviour</summary>
      <description>Default window maximized behaviour</description>
    </key>
    <key name="last-used-session" type="s">
      <default>''</default>
      <summary>Last used session</summary>
      <description>The directory name of the last used session</description>
    </key>
    <key name="notifications-enabled" type="b">
      <default>true</default>
      <summary>Enable notifications</summary>
      <description>Whether to show desktop notifications for new messages</description>
    </key>
    <key name="proxy-auto-switch-deadline" type="i">
      <default>10</default>
      <summary>Automatic proxy switch deadline</summary>
      <description>
        Seconds without a connection after which the next proxy from the
        list is tried. 0 disables automatic switching.
      </description>
    </key>
    <key name="color-scheme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="light"/>
        <choice value="dark"/>
      </choices>
      <default>'default'</default>
      <summary>Color Scheme</summary>
      <description>The color scheme to be used in the app</description>
    </key>
    <key name="recent-emojis" type="as">
      <default>[]</default>
      <summary>Recently used emoji</summary>
      <description>Emoji recently inserted through the content picker</description>
    </key>
    <key name="debug-options-enabled" type="b">
      <default>false</default>
      <summary>Enable debug options</summary>
      <description>Whether to expose developer/debug features such as "Copy Debug Entry" in message menus</description>
    </key>
    <key name="vertical-folders" type="b">
      <default>false</default>
      <summary>Vertical chat folders</summary>
      <description>Show chat folders as a vertical rail on the far left of the sidebar instead of a horizontal bar at the top</description>
    </key>
    <key name="sidebar-width" type="i">
      <default>300</default>
      <summary>Chat list sidebar width</summary>
      <description>The saved width, in pixels, of the resizable chat list sidebar</description>
    </key>
    <key name="content-picker-width" type="i">
      <default>360</default>
      <summary>Content picker width</summary>
      <description>The saved width, in pixels, of the resizable emoji/sticker content picker panel</description>
    </key>
  </schema>
</schemalist>
